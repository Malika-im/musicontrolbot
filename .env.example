# =================================================================
# AI Music Telegram Bot - Environment Configuration
# =================================================================

# --- Telegram Bot Settings ---
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ123456789
TELEGRAM_WEBHOOK_URL=https://your-domain.com
TELEGRAM_WEBHOOK_SECRET=your_super_secret_webhook_token_here_random_alphanumeric_64_chars

# --- Server & API Settings ---
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=production
DEBUG=False
SECRET_KEY=change_this_to_a_random_32_bytes_secret_key_for_app_security

# --- Database (PostgreSQL) ---
POSTGRES_USER=aimusic
POSTGRES_PASSWORD=aimusic_secure_password
POSTGRES_DB=aimusic_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aimusic:aimusic_secure_password@postgres:5432/aimusic_db
DATABASE_SYNC_URL=postgresql+psycopg2://aimusic:aimusic_secure_password@postgres:5432/aimusic_db

# --- Cache & Task Queue (Redis) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Storage Settings ---
STORAGE_BASE_DIR=./storage_data
MAX_FILE_SIZE_MB=50
MAX_DURATION_SECONDS=900
CLEANUP_RETENTION_HOURS=24
DISK_MIN_FREE_SPACE_GB=2.0

# --- User & Concurrency Limits ---
MAX_CONCURRENT_TASKS_PER_USER=2
PROCESSING_TIMEOUT_SECONDS=600

# --- AI & Hardware Acceleration ---
# Device: 'cuda' for NVIDIA GPU, 'cpu' for CPU processing
DEVICE=cuda
# Demucs model: 'htdemucs' (standard 4-stem), 'htdemucs_6s' (6 stems: drums, bass, other, vocals, guitar, piano), 'htdemucs_ft'
DEMUCS_MODEL=htdemucs
# Whisper model: 'tiny', 'base', 'small', 'medium', 'large'
WHISPER_MODEL=base
# Whisper compute type: 'float16' for GPU, 'float32' for CPU
WHISPER_COMPUTE_TYPE=float16

# --- LLM for Smart AudioEditPlanner ---
# Provider options: 'heuristic' (built-in rule & semantic parser, no API key needed), 'openai', 'gemini'
LLM_PROVIDER=heuristic
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini
